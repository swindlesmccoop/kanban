# Port the app listens on inside the container
PORT=4050

# Where kanban.json lives (e.g. /mnt/user/appdata/kanban)
DATA_DIR=./data

# User/group the container runs as, so you can edit kanban.json without sudo.
# Run `id` to find yours. On Unraid use PUID=99 and PGID=100 (nobody:users).
PUID=1000
PGID=1000

# Optional login. Leave blank for no password (e.g. when Caddy already handles auth).
# Changing it logs out every device.
APP_PASSWORD=
